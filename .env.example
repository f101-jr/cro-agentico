# Modo de ejecución: "fixtures" (sin red, por defecto) o "live"
CRO_MODE=fixtures

# --- LLM (solo en modo live) ---
CRO_LLM_PROVIDER=scripted          # scripted | vertex
CRO_VERTEX_PROJECT=
CRO_VERTEX_REGION=europe-west1     # región UE
CRO_VERTEX_MODEL=claude-sonnet-5@20250929
CRO_LLM_MAX_TOKENS=4096

# --- GA4 (solo en modo live) ---
# Credenciales por Application Default Credentials (gcloud auth application-default login)
# Scope requerido (solo lectura): https://www.googleapis.com/auth/analytics.readonly
CRO_GA4_PROPERTY_ID=
CRO_GA4_TIMEZONE=Europe/Madrid

# --- Shopify (solo en modo live) ---
# Scopes requeridos (solo lectura): read_orders, read_products
CRO_SHOPIFY_SHOP=mitienda.myshopify.com
CRO_SHOPIFY_TOKEN=
CRO_SHOPIFY_API_VERSION=2024-10

# --- Soporte (v1: fixtures) ---
CRO_SUPPORT_BASE_URL=

# --- Infra ---
CRO_TRACE_DB=./traces.sqlite3
CRO_RATE_LIMIT_PER_MINUTE=30
